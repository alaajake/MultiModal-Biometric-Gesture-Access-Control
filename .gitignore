# ---------- GOOGLE CLOUD / GCP SERVICE ACCOUNT KEYS (CRITICAL!) ----------
# Match ALL patterns like: plante-440018-3361026f63cc.json, *.iam.gserviceaccount.com.json, etc.
plante-*.json
*-*-*-*-*-gcp-*.json
*service_account*.json
*service-account*.json
*gserviceaccount*.json
*gcp-key*.json
*gcp_key*.json
*google-cloud-key*.json
*google_cloud_credentials*.json
# Any JSON that contains private_key / client_email (GCP / Firebase SA)
# These are also detected on push by pre-commit hooks; keep list aggressive
*credentials*.json
*creds*.json
firebase-adminsdk*.json
api-key*.txt
api_key*.txt
apikey*.txt
password*.txt
*token*.json
